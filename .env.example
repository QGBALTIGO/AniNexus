PUBLIC_PORT=127.0.0.1:18080
PUBLIC_ORIGIN=https://187.77.255.164
PUBLIC_SITE_ORIGIN=https://qgbaltigo.github.io/AniNexus
PUBLIC_API_ORIGIN=https://187.77.255.164
NODE_ENV=production
POSTGRES_PASSWORD=troque-por-uma-senha-unica-com-32-ou-mais-caracteres
REDIS_PASSWORD=change-me-before-production-change-me
IP_HASH_SALT=troque-por-outro-segredo-unico-com-32-ou-mais-caracteres
COOKIE_SECURE=true

# Clerk: identidade no frontend e verificação exclusiva no backend.
# A chave publicável começa com pk_; nunca prefixe a chave secreta com PUBLIC_.
AUTH_PROVIDER=clerk
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=https://qgbaltigo.github.io,https://187.77.255.164
# Só use true quando PUBLIC_API_ORIGIN possuir HTTPS válido.
PUBLIC_AUTH_ENABLED=true

# Conta e sessão
SESSION_DAYS=30
MAX_SESSIONS_PER_USER=10
SESSION_CACHE_SECONDS=30
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=3

# Banco/cache e upstreams
PG_POOL_MIN=0
PG_POOL_MAX=30
NEWS_PG_POOL_MAX=5
UPSTREAM_TIMEOUT_MS=9000
PERSIST_MEDIA_CACHE=true

# Analytics assíncrono: evita um INSERT por visita.
ANALYTICS_MAX_QUEUE=10000
ANALYTICS_FLUSH_MS=1000
ANALYTICS_BATCH_SIZE=500
ANALYTICS_SAMPLE_RATE=1

# Notícias
NEWS_WORKER_INTERVAL_MS=300000
NEWS_RETENTION_DAYS=7
# Se as fontes ficarem temporariamente indisponíveis, mantém o último feed bom por esta janela.
NEWS_STALE_GRACE_DAYS=14
NEWS_MAX_PER_SOURCE=45
NEWS_MAX_STORIES=60
NEWS_MAX_SOURCE_AGE_HOURS=168
NEWS_MIN_QUALITY=0.50
# Opcional: endpoint de tradução compatível com query `q=`. Se vazio, usa o fallback padrão do worker.
NEWS_TRANSLATE_ENDPOINT=

# Deploy da VPS (GitHub Secrets; não são lidos pela aplicação)
VPS_HOST=
VPS_USER=
VPS_PORT=22
VPS_SSH_KEY=
VPS_KNOWN_HOSTS=
# GitHub Variable pública (não é segredo)
VPS_HEALTH_ORIGIN=https://187.77.255.164
